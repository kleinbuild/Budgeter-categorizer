# Settings for one development machine.
# Copy this file to .env and fill it in. .env is never committed.
#
# The app does not load this file. It records what is true on this machine,
# for you and for any AI agent working in the repo, so nothing has to guess
# from another machine's paths.

# A short name for this machine, for example: windows-pc, macbook, linux-box
DEV_BOX=

# One of: windows, macos, linux
DEV_OS=

# Absolute path of this checkout on this machine
REPO_DIR=

# Where Ollama listens on this machine
OLLAMA_HOST=127.0.0.1:11434

# The Ollama model to test with on this machine.
# The app's default is gemma3:4b. Run "ollama list" to see what is pulled here.
OLLAMA_MODEL=
